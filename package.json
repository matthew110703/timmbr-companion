{
  "name": "timmbr-companion",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "node scripts/run-android.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "apk:dev": "node scripts/build-apk.mjs dev",
    "apk:stage": "node scripts/build-apk.mjs stage",
    "ipa:dev": "eas build -p ios --profile development",
    "ipa:stage": "eas build -p ios --profile preview",
    "prod:android": "eas build -p android --profile production",
    "prod:ios": "eas build -p ios --profile production",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "ds:link": "node scripts/ds-link.mjs link",
    "ds:unlink": "node scripts/ds-link.mjs unlink",
    "ds:status": "node scripts/ds-link.mjs status",
    "ds:check": "node scripts/ds-link.mjs check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@hookform/resolvers": "^3.10.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.66.0",
    "@timmbr/icons": "1.7.0",
    "@timmbr/native-ui": "1.0.2",
    "@timmbr/theme": "1.3.0",
    "@timmbr/utils": "1.6.0",
    "expo": "~58.0.25",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "lucide-react": "^0.475.0",
    "lucide-react-native": "^0.475.0",
    "nativewind": "^4.1.23",
    "query-string": "^7.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/js": "^9.20.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.20.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.0.0",
    "yalc": "1.0.0-pre.53"
  }
}
